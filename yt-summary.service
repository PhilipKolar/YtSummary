[Unit]
Description=YouTube Summary Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=phil
WorkingDirectory=/home/phil/repos/yt-summary
ExecStart=/home/phil/repos/yt-summary/venv/bin/python3 bot.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
